---
import AboutMe from "../content/about-me.md";
import WhatIDo from "../content/what-i-do.md";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import HeroSection from "../components/HeroSection.astro";
import InfoBox from "../components/InfoBox.astro";
import SocialLinks from "../components/SocialLinks.astro";
---

<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main id="top" class="page-shell">
            <HeroSection eyebrow="welcome" title="Tell me something about yourself" />
            <AboutMe />
            <div class="postlist-grid-container">
                <slot />
                <aside>
                    <InfoBox title="Socials" content="If anyone asks for Johnny, tell them to look elswhere. Johnny left the building." >
                        <SocialLinks />
                    </InfoBox>
                </aside>
            </div>
        </main>
    </body>
</html>



<style>
    main {
        color: var(--text);
    }
    ul {
        display: flex;
        justify-content: space-between;
        list-style: none;
        max-width: 50%;
    }

    li {
        text-align: left;
    }
</style>
