---
import PostSingleLayout from "../../layouts/PostSingleLayout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

// creates dynamic paths for each filename.md in a collection directory
export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { post: post.id.replace(/\.(md|mdx)$/i, "") },
        props: { post },
    }));
}

const { post } = Astro.props;
const { title, description, pubDate, category, thumbnail, heroImage, tags } =
    post.data;
const { Content } = await render(post);
const date = pubDate.toLocaleDateString("en-UK", {
    month: "short",
    day: "numeric",
    year: "numeric",
});
---

<PostSingleLayout>
        <div class="post-eyebrow">
            <p class="post-date">
                <time datetime={post.data.pubDate.toISOString()}>{date}</time>
            </p>
            <p class="post-category">{category}</p>
        </div>

        <h1>{title}</h1>
        <p>#TAG1 #TAG2 #TAG3</p>

        {thumbnail && <Image src={thumbnail} alt={title} />}

        <Content />
</PostSingleLayout>
