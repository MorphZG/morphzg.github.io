---
import { getCollection } from "astro:content";
import PostlistLayout from "../../layouts/PostlistLayout.astro";

const posts = await getCollection("blog");
posts.sort((a, b) => {
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
---

<PostlistLayout>
    <section id="posts" class="posts">
        <div class="section-heading">
            <h2>Latest posts</h2>
        </div>

        <main class="post-grid">
            {
                posts.map((post) => {
                    const slug = post.id.replace(/\.(md|mdx)$/i, "");
                    return (
                        <article class="post-card">
                            <div class="post-eyebrow">
                                <p class="post-date">
                                    {post.data.pubDate.toLocaleDateString(
                                        "en-UK",
                                        {
                                            month: "short",
                                            day: "numeric",
                                            year: "numeric",
                                        },
                                    )}
                                </p>
                                <p class="post-read-time">10min</p>
                                <p class="post-category">webdev</p>
                            </div>
                            <h3>
                                <a href={`/posts/${slug}`}>{post.data.title}</a>
                            </h3>
                            <p>{post.data.description}</p>
                        </article>
                    );
                })
            }
        </main>
    </section>
</PostlistLayout>
