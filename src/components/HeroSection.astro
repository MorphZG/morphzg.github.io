---
const {
    eyebrow = "Welcome",
    title = "Writing by Me",
    description="From a vast fields of cyberspace, somewhere far away from everything. We got a signal!",
} = Astro.props;
---

<section class="hero">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
</section>
