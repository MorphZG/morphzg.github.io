---
const { content, title, href, link } = Astro.props;
---

<h3>{title}</h3>
<p>{content}</p>
<a href={href}>{link}</a>

<style>
    p {
        color: var(--muted);
        font-family: var(--sans);
        font-size: var(--font-m);
    }
    a {
        color: var(--accent);
        font-family: var(--sans);
        font-size: var(--font-s);
    }
</style>