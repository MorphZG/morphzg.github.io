---
const { textContent, title, link } = Astro.props;
---

<h3>{title}</h3>
<p>{textContent}</p>
<a href={link}>Read more...</a>

<style>
    p {
        color: var(--muted);
        font-family: var(--sans);
        font-size: var(--font-m);
    }
    a {
        color: var(--accent);
        font-family: var(--sans);
        font-size: var(--font-s);
    }
</style>